<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>4H Market</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;0,900;1,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F1EFE4;
    --bg-alt: #E7E3D4;
    --card: #FBF9F2;
    --ink: #1E2A22;
    --ink-soft: #52604F;
    --forest: #2F4B3C;
    --forest-deep: #223A2D;
    --marigold: #E8A33D;
    --marigold-deep: #C9821F;
    --line: rgba(30,42,34,0.14);
  }
  :root:not([data-theme="light"]) {
    @media (prefers-color-scheme: dark) {
      --bg: #1B1F1A;
      --bg-alt: #14181300;
      --card: #232922;
      --ink: #F1EFE4;
      --ink-soft: #B9C2B4;
      --forest: #6FA687;
      --forest-deep: #8FC1A2;
      --marigold: #F0B15A;
      --marigold-deep: #F5C27E;
      --line: rgba(241,239,228,0.16);
    }
  }
  :root[data-theme="dark"] {
    --bg: #1B1F1A;
    --bg-alt: #14181300;
    --card: #232922;
    --ink: #F1EFE4;
    --ink-soft: #B9C2B4;
    --forest: #6FA687;
    --forest-deep: #8FC1A2;
    --marigold: #F0B15A;
    --marigold-deep: #F5C27E;
    --line: rgba(241,239,228,0.16);
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Work Sans', system-ui, sans-serif;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    line-height: 1.55;
  }
  h1, h2, h3, .display { font-family: 'Fraunces', Georgia, serif; }
  a { color: inherit; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 0 24px; }

  header {
    position: sticky; top: 0;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
    z-index: 10;
  }
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; }
  .logo { font-family: 'Fraunces', serif; font-weight: 900; font-size: 1.4rem; letter-spacing: -0.01em; }
  .logo span { color: var(--marigold-deep); }
  .navlinks { display: flex; gap: 22px; font-size: 0.95rem; color: var(--ink-soft); }
  .navlinks a { text-decoration: none; }
  .navlinks a:hover { color: var(--forest); }
  .btn-wa {
    background: var(--forest); color: #fff; text-decoration: none;
    padding: 10px 18px; border-radius: 4px; font-size: 0.92rem; font-weight: 500;
    white-space: nowrap;
  }
  :root:has([data-theme]) .btn-wa {}
  .btn-wa:hover { background: var(--forest-deep); }
  @media (max-width: 640px) { .navlinks { display: none; } }

  .hero {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center;
    padding: 64px 24px 56px;
  }
  @media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding-top: 40px; } }
  .hero h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 700; line-height: 1.08; margin: 0 0 18px; max-width: 14ch; }
  .hero p { color: var(--ink-soft); font-size: 1.08rem; max-width: 42ch; margin: 0 0 28px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--marigold); color: var(--forest-deep); text-decoration: none;
    padding: 13px 24px; border-radius: 4px; font-weight: 600; font-size: 0.98rem;
  }
  .btn-primary:hover { background: var(--marigold-deep); color: #fff; }
  .btn-ghost {
    border: 1px solid var(--line); text-decoration: none; color: var(--ink);
    padding: 12px 22px; border-radius: 4px; font-size: 0.98rem;
  }

  .storefront { width: 100%; max-width: 340px; justify-self: center; }

  section { padding: 56px 24px; border-top: 1px solid var(--line); }
  .section-head { max-width: 56ch; margin-bottom: 32px; }
  .section-head h2 { font-size: 1.7rem; font-weight: 700; margin: 0 0 10px; }
  .section-head p { color: var(--ink-soft); margin: 0; }

  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 700px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  .cat-card {
    background: var(--card); border-left: 4px solid var(--cat-color, var(--forest));
    padding: 20px 18px; border-radius: 3px;
  }
  .cat-card h3 { margin: 0 0 6px; font-size: 1.05rem; font-weight: 600; }
  .cat-card p { margin: 0; font-size: 0.88rem; color: var(--ink-soft); }

  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  @media (max-width: 700px) { .info-grid { grid-template-columns: 1fr; } }
  .info-block h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; color: var(--forest); }
  .info-block p { margin: 0 0 4px; color: var(--ink-soft); font-size: 0.98rem; }

  footer {
    border-top: 1px solid var(--line); padding: 40px 24px;
    padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px));
    display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between;
  }
  footer p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
</head>
<body>

